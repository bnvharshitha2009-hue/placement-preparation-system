# Copy this file to ".env" (already ignored by .gitignore) in this folder
# and fill in your credentials so Flask loads them automatically on startup.
#
# To create a Google App Password (requires 2-Step Verification):
#   https://myaccount.google.com/apppasswords
#
# To generate verified placement practice questions with Gemini:
#   https://aistudio.google.com/apikey

GMAIL_SENDER=youraccount@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
SECRET_KEY=change-this-to-a-random-string
# GEMINI_API_KEY=your-gemini-api-key
